# Builds the barwatch desktop app from this checkout:
#
#   git clone https://github.com/u6bkep/barwatch && cd barwatch/packaging/arch && makepkg -si
#
# Installing it is all the setup there is: the package's .desktop file claims
# barwatch:// links, and pacman's desktop-database hook activates it.
pkgname=barwatch-git
pkgver=0.2.0
pkgrel=1
pkgdesc="Watch Beyond All Reason replays together: joins a barwatch server"
arch=('x86_64')
url="https://github.com/u6bkep/barwatch"
license=('MIT OR Apache-2.0')
depends=('gcc-libs' 'glibc' 'vulkan-icd-loader' 'libxkbcommon' 'wayland' 'xdg-utils')
makedepends=('cargo' 'git')
optdepends=('p7zip: fallback when an engine archive cannot be unpacked natively'
            'libx11: run under X11 instead of Wayland')
provides=('barwatch')
conflicts=('barwatch')
options=('!lto' '!debug')

# The sources are the checkout this file sits in.
_repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

pkgver() {
  cd "$_repo"
  local base
  base="$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)"
  printf '%s.r%s.g%s' "$base" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$_repo"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --release --locked -p barwatch
}

package() {
  cd "$_repo"
  install -Dm755 "$srcdir/target/release/barwatch" "$pkgdir/usr/bin/barwatch"
  install -Dm644 packaging/barwatch.desktop "$pkgdir/usr/share/applications/barwatch.desktop"
  install -Dm644 packaging/barwatch.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/barwatch.svg"
  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}
